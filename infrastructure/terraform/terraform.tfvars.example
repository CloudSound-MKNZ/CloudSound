# CloudSound Azure Infrastructure Configuration
# Copy this file to terraform.tfvars and update with your values

# Azure Configuration
resource_group_name = "cloudsound-rg"
location            = "eastus"  # Change to your preferred region
project_name        = "cloudsound"
environment         = "production"

# AKS Configuration
kubernetes_version      = "1.28.3"
aks_node_count          = 2
aks_node_size           = "Standard_B2s"  # Cost-effective for student credits
aks_enable_autoscaling  = false
aks_min_count           = 2
aks_max_count           = 5

# PostgreSQL Configuration
postgres_admin_user     = "cloudsoundadmin"
# postgres_admin_password will be auto-generated if not set
# postgres_admin_password = "YourSecurePassword123!"
postgres_sku_name       = "B_Standard_B1ms"  # Basic tier for cost savings
postgres_storage_mb     = 32768  # 32GB
postgres_database_name  = "cloudsound"

# Storage Configuration
storage_account_tier       = "Standard"
storage_replication_type   = "LRS"

# Monitoring Configuration
log_retention_days = 30

# Optional Features
enable_app_gateway = false

# Admin email for SSL certificates and notifications
admin_email = "your-email@example.com"

# Additional tags
tags = {
  Project     = "CloudSound"
  ManagedBy   = "Terraform"
  Owner       = "YourName"
}

