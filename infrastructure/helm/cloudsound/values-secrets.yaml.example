# CloudSound Secrets Configuration
# Copy this to values-secrets.yaml and fill in your actual values
# DO NOT COMMIT values-secrets.yaml to git!

secrets:
  secretKey: "your-secure-random-string-here"
  
  # Facebook API credentials
  # Get these from: https://developers.facebook.com/tools/explorer/
  facebookAccessToken: "your-facebook-page-access-token"
  facebookPageIds: "your-facebook-page-id"

