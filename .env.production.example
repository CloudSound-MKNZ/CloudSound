# CloudSound Production Environment Configuration
# NEVER commit actual production secrets to Git!
ENVIRONMENT=production
APP_NAME=CloudSound
DEBUG=false
USE_MOCK_APIS=false
SEED_MOCK_DATA=false
POSTGRES_HOST=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME_USE_SECRET_MANAGER
POSTGRES_DB=cloudsound_prod
KAFKA_BOOTSTRAP_SERVERS=CHANGE_ME
RABBITMQ_HOST=CHANGE_ME
RABBITMQ_PASSWORD=CHANGE_ME_USE_SECRET_MANAGER
MINIO_ENDPOINT=s3.amazonaws.com
MINIO_SECURE=true
SECRET_KEY=CHANGE_ME_USE_SECRET_MANAGER_GENERATE_STRONG_KEY
LOG_LEVEL=INFO
LOG_FORMAT=json
YOUTUBE_API_KEY=CHANGE_ME
BANDCAMP_API_KEY=CHANGE_ME
FACEBOOK_ACCESS_TOKEN=CHANGE_ME
