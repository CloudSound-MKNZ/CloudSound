# CloudSound Development Environment Configuration
# Copy this file to .env.development and customize as needed

# Environment
ENVIRONMENT=development

# Application
APP_NAME=CloudSound
APP_VERSION=1.0.0
DEBUG=true

# Feature Flags
USE_MOCK_APIS=true
SEED_MOCK_DATA=true

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=cloudsound
POSTGRES_PASSWORD=cloudsound_dev
POSTGRES_DB=cloudsound

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CLIENT_ID=cloudsound-dev

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=cloudsound
RABBITMQ_PASSWORD=cloudsound_dev
RABBITMQ_VHOST=/

# MinIO/S3
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=cloudsound-music
MINIO_SECURE=false

# Security (CHANGE IN PRODUCTION!)
SECRET_KEY=dev-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Logging
LOG_LEVEL=DEBUG
LOG_FORMAT=text

# Service URLs (for local development)
API_GATEWAY_URL=http://localhost:8000
CONCERT_MANAGEMENT_URL=http://localhost:8001
EVENT_MANAGER_URL=http://localhost:8002
MUSIC_DISCOVERY_URL=http://localhost:8003
RADIO_STREAMING_URL=http://localhost:8004
ADMIN_MANAGEMENT_URL=http://localhost:8005
AUTHENTICATION_URL=http://localhost:8006
ANALYTICS_URL=http://localhost:8007

# External APIs (optional - only needed if USE_MOCK_APIS=false)
YOUTUBE_API_KEY=
BANDCAMP_API_KEY=
FACEBOOK_ACCESS_TOKEN=
